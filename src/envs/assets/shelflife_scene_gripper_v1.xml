                <geom name="g_left_pad1" class="g_pad_box1" pos="0 -0.0026 0.028125" mass="0"/>
                <geom name="g_left_pad2" class="g_pad_box2" pos="0 -0.0026 0.009375" mass="0"/>
                <geom class="g_visual" mesh="g_pad"/>
                <body name="g_left_silicone_pad">
                  <geom class="g_visual" material="g_black" mesh="g_silicone_pad"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <contact>
    <exclude body1="g_base" body2="g_right_driver"/>
    <exclude body1="g_base" body2="g_right_spring_link"/>
    <exclude body1="g_base" body2="g_left_driver"/>
    <exclude body1="g_base" body2="g_left_spring_link"/>
    <exclude body1="g_right_coupler" body2="g_right_follower"/>
    <exclude body1="g_left_coupler" body2="g_left_follower"/>
  </contact>

  <equality>
    <connect body1="g_right_follower" body2="g_right_coupler" anchor="0 0 0" solref="0.005" solimp="0.95 0.99"/>
    <connect body1="g_left_follower" body2="g_left_coupler" anchor="0 0 0" solref="0.005" solimp="0.95 0.99"/>
    <joint joint1="g_right_driver_joint" joint2="g_left_driver_joint" polycoef="0 1 0 0 0" solref="0.005" solimp="0.95 0.99"/>
  </equality>

  <tendon>
    <fixed name="g_split">
      <joint joint="g_right_driver_joint" coef="0.5"/>
      <joint joint="g_left_driver_joint" coef="0.5"/>
    </fixed>
  </tendon>

  <actuator>
    <general name="act_gx" joint="gx" ctrlrange="-1 1" biastype="affine" gainprm="2000" biasprm="0 -2000 -120"/>
    <general name="act_gy" joint="gy" ctrlrange="-1 1" biastype="affine" gainprm="2000" biasprm="0 -2000 -120"/>
    <general name="act_gz" joint="gz" ctrlrange="0 2" biastype="affine" gainprm="2000" biasprm="0 -2000 -120"/>
    <general name="act_gyaw" joint="gyaw" ctrlrange="-3.15 3.15" biastype="affine" gainprm="60" biasprm="0 -60 -8"/>
    <general name="act_gpitch" joint="gpitch" ctrlrange="-3.15 3.15" biastype="affine" gainprm="60" biasprm="0 -60 -8"/>
    <general name="act_groll" joint="groll" ctrlrange="-3.15 3.15" biastype="affine" gainprm="60" biasprm="0 -60 -8"/>
    <general name="g_fingers_actuator" class="g_2f85" tendon="g_split" ctrlrange="0 255" forcerange="-5 5" gainprm="0.313725" biasprm="0 -100 -10"/>
  </actuator>
</mujoco>
