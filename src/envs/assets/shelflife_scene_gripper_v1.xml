          <geom class="g_collision" mesh="g_base"/>
          <site name="g_pinch" pos="0 0 0.145" group="5" rgba="0.9 0.9 0.9 1"/>
          <body name="g_right_driver" pos="0 0.0306011 0.054904">
            <inertial pos="2.96931e-12 0.0177547 0.00107314" quat="0.681301 0.732003 0 0" mass="0.00899563" diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
            <joint name="g_right_driver_joint" class="g_driver" pos="0 0 0" axis="1 0 0"/>
            <geom class="g_visual" material="g_gray" mesh="g_driver"/>
            <geom class="g_collision" mesh="g_driver"/>
            <body name="g_right_coupler" pos="0 0.0315 -0.0041">
              <inertial pos="0 0.00301209 0.0232175" quat="0.705636 -0.0455904 0.0455904 0.705636" mass="0.0140974" diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
              <joint name="g_right_coupler_joint" class="g_coupler" pos="0 0 0" axis="1 0 0"/>
              <geom class="g_visual" material="g_black" mesh="g_coupler"/>
              <geom class="g_collision" mesh="g_coupler"/>
            </body>
          </body>
          <body name="g_right_spring_link" pos="0 0.0132 0.0609">
            <inertial pos="-8.65005e-09 0.0181624 0.0212658" quat="0.663403 -0.244737 0.244737 0.663403" mass="0.0221642" diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
            <joint name="g_right_spring_link_joint" class="g_spring_link" pos="0 0 0" axis="1 0 0" springref="2.62"/>
            <geom class="g_visual" material="g_black" mesh="g_spring_link"/>
            <geom class="g_collision" mesh="g_spring_link"/>
            <body name="g_right_follower" pos="0 0.055 0.0375">
