    <body name="product_0" pos="0.3891 -0.2 1.064">
      <joint name="product_0_free" type="free"/>
      <geom name="product_0_col" size="0.02905 0.0727" pos="0 0 0.0727" type="cylinder" condim="4" friction="0.7 0.02 0.002" mass="0.343" material="mat_can"/>
    </body>
    <body name="mount">
      <joint name="gx" pos="0 0 0" axis="1 0 0" type="slide" range="-1 1" armature="1" damping="20"/>
      <joint name="gy" pos="0 0 0" axis="0 1 0" type="slide" range="-1 1" armature="1" damping="20"/>
      <joint name="gz" pos="0 0 0" axis="0 0 1" type="slide" range="0 2" armature="1" damping="20"/>
      <joint name="gyaw" pos="0 0 0" axis="0 0 1" range="-3.15 3.15" armature="0.05" damping="2"/>
      <joint name="gpitch" pos="0 0 0" axis="0 1 0" range="-3.15 3.15" armature="0.05" damping="2"/>
      <joint name="groll" pos="0 0 0" axis="1 0 0" range="-3.15 3.15" armature="0.05" damping="2"/>
