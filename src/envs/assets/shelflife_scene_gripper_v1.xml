            <geom class="g_visual" material="g_black" mesh="g_spring_link"/>
            <geom class="g_collision" mesh="g_spring_link"/>
            <body name="g_left_follower" pos="0 0.055 0.0375">
              <inertial pos="0 -0.011046 0.0124786" quat="0.986437 0.164143 0 0" mass="0.0125222" diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
