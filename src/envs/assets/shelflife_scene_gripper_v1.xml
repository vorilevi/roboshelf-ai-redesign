<mujoco model="shelflife_gripper">
  <compiler angle="radian"/>

  <option impratio="10" cone="elliptic"/>

  <visual>
    <global offwidth="1280" offheight="1024"/>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.5 0.5 0.5" specular="0.1 0.1 0.1"/>
  </visual>

  <default>
    <default class="g_main">
      <default class="g_2f85">
        <mesh scale="0.001 0.001 0.001"/>
        <general biastype="affine"/>
        <default class="g_driver">
          <joint solreflimit="0.005" solimplimit="0.95 0.99" range="0 0.8" armature="0.005" damping="0.1"/>
        </default>
        <default class="g_follower">
          <joint solreflimit="0.005" solimplimit="0.95 0.99" range="-0.872664 0.872664" armature="0.001"/>
        </default>
        <default class="g_spring_link">
          <joint springref="2.62" stiffness="0.05" range="-0.296706 0.8" armature="0.001" damping="0.00125"/>
        </default>
        <default class="g_coupler">
          <joint solreflimit="0.005" solimplimit="0.95 0.99" range="-1.57 0" armature="0.001"/>
        </default>
        <default class="g_visual">
          <geom type="mesh" contype="0" conaffinity="0" group="2"/>
        </default>
        <default class="g_collision">
          <geom type="mesh" group="3"/>
          <default class="g_pad_box1">
            <geom size="0.011 0.004 0.009375" type="box" priority="1" friction="0.7" solref="0.004" solimp="0.95 0.99" rgba="0.55 0.55 0.55 1"/>
          </default>
          <default class="g_pad_box2">
            <geom size="0.011 0.004 0.009375" type="box" priority="1" friction="0.6" solref="0.004" solimp="0.95 0.99" rgba="0.45 0.45 0.45 1"/>
          </default>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="mat_board" specular="0.1" shininess="0.1" rgba="0.72 0.7 0.66 1"/>
    <material name="mat_can" specular="0.3" shininess="0.4" rgba="0.85 0.1 0.12 1"/>
    <material name="g_metal" rgba="0.58 0.58 0.58 1"/>
    <material name="g_silicone" rgba="0.1882 0.1882 0.1882 1"/>
    <material name="g_gray" rgba="0.4627 0.4627 0.4627 1"/>
    <material name="g_black" rgba="0.149 0.149 0.149 1"/>
    <mesh name="g_base_mount" class="g_2f85" file="base_mount.stl"/>
    <mesh name="g_base" class="g_2f85" file="base.stl"/>
    <mesh name="g_driver" class="g_2f85" file="driver.stl"/>
    <mesh name="g_coupler" class="g_2f85" file="coupler.stl"/>
    <mesh name="g_follower" class="g_2f85" file="follower.stl"/>
    <mesh name="g_pad" class="g_2f85" file="pad.stl"/>
    <mesh name="g_silicone_pad" class="g_2f85" file="silicone_pad.stl"/>
    <mesh name="g_spring_link" class="g_2f85" file="spring_link.stl"/>
  </asset>

  <worldbody>
    <geom name="floor" size="3 3 0.1" type="plane" rgba="0.9 0.9 0.9 1"/>
    <geom name="shelf_board_1" size="0.175 0.45 0.012" pos="0.4 0 1.05" type="box" material="mat_board"/>
    <light pos="-0.6 -0.6 2" dir="0.348155 0.348155 -0.870388"/>
    <light pos="-0.6 0.6 2" dir="0.348155 -0.348155 -0.870388" diffuse="0.5 0.5 0.5"/>
