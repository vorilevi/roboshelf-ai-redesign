              <joint name="g_right_follower_joint" class="g_follower" pos="0 -0.018 0.0065" axis="1 0 0"/>
              <geom class="g_visual" material="g_black" mesh="g_follower"/>
              <geom class="g_collision" mesh="g_follower"/>
              <body name="g_right_pad" pos="0 -0.0189 0.01352">
                <inertial pos="0 -0.0025 0.0185" quat="0.707107 0 0 0.707107" mass="0.0035" diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
                <geom name="g_right_pad1" class="g_pad_box1" pos="0 -0.0026 0.028125" mass="0"/>
                <geom name="g_right_pad2" class="g_pad_box2" pos="0 -0.0026 0.009375" mass="0"/>
                <geom class="g_visual" mesh="g_pad"/>
                <body name="g_right_silicone_pad">
                  <geom class="g_visual" material="g_black" mesh="g_silicone_pad"/>
                </body>
              </body>
            </body>
          </body>
          <body name="g_left_driver" pos="0 -0.0306011 0.054904" quat="0 0 0 1">
            <inertial pos="0 0.0177547 0.00107314" quat="0.681301 0.732003 0 0" mass="0.00899563" diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
            <joint name="g_left_driver_joint" class="g_driver" pos="0 0 0" axis="1 0 0"/>
            <geom class="g_visual" material="g_gray" mesh="g_driver"/>
            <geom class="g_collision" mesh="g_driver"/>
            <body name="g_left_coupler" pos="0 0.0315 -0.0041">
              <inertial pos="0 0.00301209 0.0232175" quat="0.705636 -0.0455904 0.0455904 0.705636" mass="0.0140974" diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
