        <quality shadowsize="2048"/>
        <map znear="0.01" zfar="20"/>
    </visual>

    <default>
        <default class="gr1">
            <geom material="medium_gray"/>
            <site rgba="1 0 0 1" size="0.01" group="5"/>
            <joint frictionloss="0.1" armature="0.005"/>
            <position inheritrange="1" kp="75" kv="5"/>
            <default class="visual">
                <geom type="mesh" contype="0" conaffinity="0" group="2"/>
            </default>
            <default class="collision">
                <geom group="3"/>
            </default>
        </default>
        <!-- passive_joint: a nem működtetett ízületek (láb, derék, fej, csukló).
             2026-08-01 FIX — stiffness hozzáadva.
             Előtte csak damping volt, rugóerő NÉLKÜL: a csillapítás lassítja a
             roskadást, de nem állítja meg. Mérés (konstans PUSH_ARM_POS parancs,
             kéz z-magassága): t=20: 0.826 → t=60: 0.800 → t=120: 0.764 m, még
             mindig süllyedve. A csípő/boka/derék 0.22–0.39 rad-ot mozdult.
             Következmény: a kar sosem került egyensúlyba, és a scripted expert
             SETTLE_STEPS=80-a valójában egy tranziens pillanatot kapott el
             (amikor a kéz épp a stock magassági sávjában járt) — nem beállást.
             Ez tette a push-triggert nem-megfigyelhetővé (belső lépésszámláló),
             és ezért volt a VLA-nak tanulhatatlan a feladat (20% eval SR).
             stiffness=100000 + damping=500 → az egyensúly gyakorlatilag a
             reset-póz (alsótest elmozdulás 0.016 rad), qacc→0, a kéz z-je
             150 lépésen át 0.0 mm-t sodródik.
             Csak a GR1T1 scene-t érinti; a G1 és T1 scene változatlan. -->
        <default class="passive_joint">
            <joint damping="500.0" armature="0.5" stiffness="100000.0"/>
        </default>
        <default class="arm_joint">
            <joint damping="2.0" armature="0.01"/>
        </default>
        <default class="arm_motor">
            <position kp="150" forcerange="-20 20" ctrlrange="-3.14 3.14"/>
        </default>
        <default class="product_box">
            <geom friction="0.8 0.01 0.001" condim="4" solref="0.02 1" solimp="0.9 0.95 0.001"/>
        </default>
    </default>

