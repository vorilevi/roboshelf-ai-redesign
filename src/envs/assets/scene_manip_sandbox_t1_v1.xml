<!--
  ROBOSHELF AI — Manipulációs Sandbox Scene — Booster T1 v1
  Létrehozva: 2026-07-24

  Robot: Booster T1 (23 DOF humanoid)
  Gyártó: Booster Robotics — MÁS GYÁRTÓ, MINT UNITREE! (vendor-independence validálás)
  Forrás: mujoco_menagerie/booster_t1/t1.xml (Apache 2.0)

  Felépítés:
    - T1 robot — rögzített Trunk (nincs freejoint, nincs pelvis floating)
    - Lábak, fej, derék: passzív (high damping, nincs actuator)
    - Jobb kar: aktív (4 DOF: Right_Shoulder_Pitch/Roll + Right_Elbow_Pitch/Yaw)
    - Storage asztal (x=0.30): robot előtt (konzervatív — T1 kar rövidebb mint G1)
    - Gondola A (x=-0.5): robot mögött, 4 polcszinttel
    - Push task: termék (x=0.30) → target (x=0.30, y=0, z=0.77) oldalirányú tolás

  Összehasonlítás a G1 scene-nel (scene_manip_sandbox_v2.xml):
    - T1 Trunk pos z=0.665m (vs G1 pelvis z=0.793m — T1 alacsonyabb)
    - T1 kar: Shoulder Pitch/Roll + Elbow Pitch/YAW (vs G1: Pitch/Roll/YAW + Pitch)
    - T1 nincs kéz/gripper (push task → nincs szükség rá)
    - T1 right_hand_site: right_hand_link-en, pos="0 -0.15 0" (saját body frame)
    - Storage asztal x=0.30 (vs G1 x=0.45) — rövidebb karhoz igazítva

  ⚠️ TODO a diag_arm_reach_t1.py futtatása után:
    - Mért T1 arm max_x alapján döntsd el: x=0.30 elegendő-e, vagy közelebb kell
    - DEFAULT_ARM_POS T1-re meghatározása (4D grid search, t1 joint nevekkel)
    - kp értékek validálása kp_sweep_t1.py-val (most: kp=150, G1-ről örökölve)

  Kapcsolódó G1 fájlok (NE MÓDOSÍTSD):
    - scene_manip_sandbox_v2.xml  ← G1 env (30% SR, ne bolygasd!)
    - data/lerobot/vla_v1/        ← G1 demo adatok
    - results/vla_ckpt/           ← G1 VLA checkpoint
-->
<mujoco model="roboshelf_manip_sandbox_t1_v1">

  <!-- meshdir: src/envs/assets/ → mujoco_menagerie/booster_t1/assets/ -->
  <compiler angle="radian" autolimits="true"
            meshdir="../../../mujoco_menagerie/booster_t1/assets"/>

  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <global azimuth="120" elevation="-25" offwidth="1920" offheight="1080"/>
    <quality shadowsize="2048"/>
    <map znear="0.01" zfar="20"/>
  </visual>

  <default>
    <!-- T1 alap defaults (az eredeti t1.xml-ből örökölve) -->
    <default class="t1">
      <geom material="medium_gray"/>
      <site rgba="1 0 0 1" size="0.01" group="5"/>
      <joint frictionloss="0.1" armature="0.005"/>
      <position inheritrange="1" kp="75" kv="5"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3"/>
      </default>
    </default>

    <!-- Passzív jointok (lábak, fej, derék): high damping, nincs actuator -->
    <default class="passive_joint">
      <joint damping="200.0" armature="0.5"/>
    </default>

    <!-- Aktív jobb kar váll/könyök -->
    <default class="arm_joint">
      <joint damping="2.0" armature="0.01"/>
    </default>

    <!-- Aktív jobb kar position actuator
         kp=150: G1-ről örökölve (kp_sweep validáció szükséges T1-re!) -->
    <default class="arm_motor">
      <position kp="150" forcerange="-15 15" ctrlrange="-3.14 3.14"/>
    </default>

    <!-- Termék doboz -->
    <default class="product_box">
      <geom friction="0.8 0.01 0.001" condim="4" solref="0.02 1" solimp="0.9 0.95 0.001"/>
    </default>
  </default>

  <asset>
    <texture name="tex_floor" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.82 0.82 0.78" rgb2="0.78 0.78 0.74"/>
    <material name="tex_floor"  texture="tex_floor" texrepeat="6 6" reflectance="0.1"/>
    <material name="mat_shelf"  rgba="0.7 0.7 0.7 1" reflectance="0.3" shininess="0.5"/>
    <material name="mat_board"  rgba="0.88 0.86 0.82 1" reflectance="0.05"/>
    <material name="mat_red"    rgba="0.85 0.15 0.15 1"/>
    <material name="mat_green"  rgba="0.15 0.70 0.25 1"/>
    <!-- T1 robot anyagok -->
    <material name="light_gray"  rgba="0.76 0.76 0.76 1"/>
    <material name="medium_gray" rgba="0.4 0.4 0.4 1"/>
    <!-- T1 mesh-ek (forrás: mujoco_menagerie/booster_t1/assets/) -->
    <mesh file="Trunk.stl"/>
    <mesh file="H1.stl"/>
    <mesh file="H2.stl"/>
    <mesh file="AL1.stl"/>
    <mesh file="AL2.stl"/>
    <mesh file="AL3.stl"/>
    <mesh file="left_hand_link.stl"/>
    <mesh file="AR1.stl"/>
    <mesh file="AR2.stl"/>
    <mesh file="AR3.stl"/>
    <mesh file="right_hand_link.stl"/>
    <mesh file="Waist.stl"/>
