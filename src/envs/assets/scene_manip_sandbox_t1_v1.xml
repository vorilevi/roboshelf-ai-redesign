  </worldbody>

  <!-- ===== AKTUÁTOROK =====
       Csak a jobb kar aktív (4 DOF). Minden más passzív (nincs actuator).
       ctrl mérete = 4 (nu=4), ARM_QPOS_START=0 az env-ben.

       Joint → Actuator megfeleltetés (G1 ↔ T1):
         right_shoulder_pitch_joint → Right_Shoulder_Pitch  (ugyanaz az axis: 0 1 0)
         right_shoulder_roll_joint  → Right_Shoulder_Roll   (ugyanaz az axis: 1 0 0)
         right_shoulder_yaw_joint   → Right_Elbow_Yaw       (KÖNYÖKNÉL van, nem vállnál!)
         right_elbow_joint          → Right_Elbow_Pitch     (ugyanaz az axis: 0 1 0) -->
  <actuator>
    <position name="right_shoulder_pitch" joint="Right_Shoulder_Pitch" class="arm_motor"/>
    <position name="right_shoulder_roll"  joint="Right_Shoulder_Roll"  class="arm_motor"/>
    <position name="right_elbow_pitch"    joint="Right_Elbow_Pitch"    class="arm_motor"/>
    <position name="right_elbow_yaw"      joint="Right_Elbow_Yaw"      class="arm_motor"/>
  </actuator>

  <!-- ===== SZENZOR ===== -->
  <sensor>
    <framepos name="s_stock_1"    objtype="body" objname="stock_1"/>
    <framepos name="s_right_hand" objtype="site" objname="right_hand_site"/>
    <framepos name="s_target"     objtype="site" objname="target_shelf"/>
    <touch    name="touch_palm"   site="right_hand_site"/>
  </sensor>

</mujoco>
